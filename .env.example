# CinemaShelf Local Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Paths (relative to project root or absolute)
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/cinemashelf.db
POSTER_CACHE_DIR=./data/posters
LOG_DIR=./data/logs
ZARFILM_PROFILE_DIR=./data/profiles/zarfilm
LETTERBOXD_PROFILE_DIR=./data/profiles/letterboxd

# External Tools & Providers
DEFAULT_PLAYER=mpv
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_RPC_SECRET=
OMDB_API_KEY=
TMDB_API_KEY=

# Optional LLM Configuration (Core works without this)
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
